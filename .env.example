# Salin menjadi .env (lokal) atau isi di Vercel > Settings > Environment Variables.
# Wajib tetap (jangan acak) di Vercel agar token valid antar instance.
SECRET_KEY=ganti-dengan-string-acak-panjang
ADMIN_EMAIL=admin@cheatshare.example.com
ADMIN_PASSWORD=ganti-password-admin
# Data demo (4 user, 12 cheatsheet, rating). Setel false untuk data kosong.
SEED_DEMO=true
DEMO_PASSWORD=Demo12345!
